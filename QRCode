<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>បង្កើត QR Code ស្វ័យប្រវត្តិ</title>
    <!-- ប្រើ Tailwind CSS សម្រាប់ការរចនា (UI) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- ទាញយក Library QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">

    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">បង្កើត QR Code</h2>
        
        <!-- ប្រអប់បញ្ចូលអត្ថបទ ឬ លីង -->
        <input type="text" id="qrText" 
               class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4" 
               placeholder="បញ្ចូលលីង ឬ ទិន្នន័យនៅទីនេះ..." 
               value="https://script.google.com/macros/s/AKfycbw1N2hnFP7IeNDRHH6Q12F2z-S3RXxikxfuwxma1s4bmtNKvFzX8sVkLCOx-oejxqJC/exec">
        
        <!-- ប៊ូតុងបង្កើត -->
        <button onclick="generateQR()" 
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition duration-200 mb-6">
            បង្កើត
        </button>

        <!-- កន្លែងសម្រាប់បង្ហាញ QR Code -->
        <div id="qrcode" class="flex justify-center p-4 border-2 border-dashed border-gray-200 rounded-md min-h-[200px]">
            <!-- QR Code នឹងលោតចេញនៅទីនេះ -->
        </div>
    </div>

    <script>
        // បង្កើតអថេរសម្រាប់ផ្ទុក QR Code Object
        let qrcode = null;

        function generateQR() {
            const textValue = document.getElementById('qrText').value;
            const qrContainer = document.getElementById('qrcode');

            if (!textValue) {
                alert("សូមបញ្ចូលលីង ឬទិន្នន័យជាមុនសិន!");
                return;
            }

            // លុប QR Code ចាស់ចេញសិន (ប្រសិនបើមាន)
            qrContainer.innerHTML = "";

            // បង្កើត QR Code ថ្មី
            qrcode = new QRCode(qrContainer, {
                text: textValue,
                width: 200,          // ទទឹង
                height: 200,         // កម្ពស់
                colorDark: "#000000",  // ពណ៌កូដ
                colorLight: "#ffffff", // ពណ៌ផ្ទៃខាងក្រោយ
                correctLevel: QRCode.CorrectLevel.H // កម្រិតច្បាស់ (H = High អនុញ្ញាតឲ្យកូដខូចខាតខ្លះនៅតែអាចស្កេនបាន)
            });
        }

        // បង្កើត QR Code ភ្លាមៗពេលបើក Web App ជាលើកដំបូង
        window.onload = generateQR;
    </script>
</body>
</html>
